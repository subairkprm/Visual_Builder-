{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexFinalReport",
  "type": "object",
  "required": [
    "status",
    "task_summary",
    "files_changed",
    "commands_run",
    "checks",
    "follow_ups"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "partial"]
    },
    "task_summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commands_run": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "key_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "follow_ups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    }
  }
}
